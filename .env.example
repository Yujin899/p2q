# Local Postgres (Prisma 7 reads this via prisma.config.ts + lib/prisma.ts)
DATABASE_URL="postgresql://postgres:password@localhost:5432/p2q?schema=public"

# Auth.js (v5) — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth — redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="replace-with-your-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-your-google-client-secret"
